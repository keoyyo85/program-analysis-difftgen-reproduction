+	String libdpath = difftgendpath + "/lib";
+	tclass_compilepath = ":"+proj_dpath+"/bug/instru0/build/classes:"
+	    +dependjpath+":"
+	    +libdpath+"/myprinter.jar:"
+	    +libdpath+"/commons-lang3-3.5.jar:"
+	    +libdpath+"/junit-4.11.jar:"
+	    +libdpath+"/evosuite-1.0.2.jar:"
