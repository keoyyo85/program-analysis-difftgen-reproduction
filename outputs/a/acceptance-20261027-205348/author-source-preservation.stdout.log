-	if (oname == null) {
-	    mi.arguments().add(ast.newNullLiteral());
-	}
-	else if (oname.equals("this")) {
-	    mi.arguments().add(ast.newThisExpression());
-	}
-	else {
-	    mi.arguments().add(ast.newSimpleName(oname));
-	}
-	return ast.newExpressionStatement(mi);
-    }
