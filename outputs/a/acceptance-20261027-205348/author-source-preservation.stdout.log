-    private boolean isEquivalent(Statement s1, Statement s2) {
-	if (s1 == null && s2 == null) { return true; }
-	else if (s1 == null && s2 != null) { return false; }
-	else if (s1 != null && s2 == null) { return false; }
-	else { return s1.toString().equals(s2.toString()); }
-    }
