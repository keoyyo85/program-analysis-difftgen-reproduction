+    public static int calculate(SingleVariableDeclaration svd) {
+
+	if (svd == null) { return 0; }
+	int h0 = calculate(svd.getType());
+	int h1 = calculate(svd.getName());
+	int h2 = calculate(svd.getInitializer());
+	int h = (h0 >= h1) ? h0 : h1;
+	h = (h >= h2) ? h : h2;
+	return h+1;
+    }    
