+
+    public String toString() {
+	String s = "";
+	s += "fppath: " + fppath + "\n";
+	s += "fploc: " + fploc + "\n";
+	s += "pppath: " + pppath + "\n";
+	s += "pploc: " + pploc + "\n";
+	s += "insert_dummy_path: " + insert_dummy_path + "\n";
+	s += "insert_dummy_ctxtloc: " + insert_dummy_ctxtloc + "\n";
+	s += "insert_dummy_info: " + insert_dummy_info + "\n";
