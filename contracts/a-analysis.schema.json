{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a.analysis.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "case_id", "case_kind", "statistics_eligible", "support_status", "scope", "sources", "diff_hunks", "changes", "unhandled_changes", "candidates", "generation", "limitations"],
  "properties": {
    "schema_version": {"const": "a.analysis.v1"},
    "artifact_kind": {"const": "candidate_inputs_not_execution_results"},
    "case_id": {"type": "string"}, "case_kind": {"enum": ["teaching", "real"]},
    "statistics_eligible": {"const": false},
    "support_status": {"enum": ["supported", "partial", "unsupported"]},
    "scope": {"type": "string"},
    "sources": {"type": "object", "additionalProperties": false, "required": ["before_source", "patch_source", "diff_path"], "properties": {"before_source": {"$ref": "#/$defs/source"}, "patch_source": {"$ref": "#/$defs/source"}, "diff_path": {"$ref": "#/$defs/source"}}},
    "diff_hunks": {"type": "array", "items": {"type": "object"}},
    "changes": {"type": "array", "items": {"type": "object", "required": ["change_id", "file", "method", "support_status", "reasons", "analysis_basis", "before", "after"], "properties": {"method": {"$ref": "#/$defs/method"}, "before": {"$ref": "#/$defs/condition"}, "after": {"$ref": "#/$defs/condition"}}}},
    "unhandled_changes": {"type": "array", "items": {"type": "object", "required": ["support_status", "reason"]}},
    "candidates": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "case_id", "method", "arguments", "provenance", "validation"], "properties": {
      "candidate_id": {"type": "string"}, "case_id": {"type": "string"}, "method": {"$ref": "#/$defs/method"},
      "arguments": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "java_type", "value"], "properties": {"name": {"type": "string"}, "java_type": {"type": "string"}, "value": {"type": ["integer", "string", "boolean", "array"]}}}},
      "provenance": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["change_id", "side", "condition", "parameter", "boundary", "offset", "rule", "measure"]}},
      "validation": {"type": "object", "required": ["type_and_config_checked", "business_validity", "path_feasibility", "oracle_used"], "properties": {"type_and_config_checked": {"const": true}, "business_validity": {"const": "not_proven"}, "path_feasibility": {"const": "not_proven"}, "oracle_used": {"const": false}}}
    }}},
    "generation": {"type": "object", "required": ["max_candidates", "max_length", "retained", "truncated_attempts", "events"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "source": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "method": {"type": "object", "additionalProperties": false, "required": ["class_name", "name", "signature", "parameters", "return_type", "is_static"], "properties": {"class_name": {"type": "string"}, "name": {"type": "string"}, "signature": {"type": "string"}, "parameters": {"type": "array", "items": {"type": "object", "required": ["name", "java_type", "varargs"]}}, "return_type": {"type": ["string", "null"]}, "is_static": {"type": "boolean"}}},
    "condition": {"type": "object", "required": ["text", "location", "statement_location", "control_kind", "controlled_ranges", "guards", "association"], "properties": {"text": {"type": "string"}, "location": {"$ref": "#/$defs/span"}, "statement_location": {"$ref": "#/$defs/span"}, "controlled_ranges": {"type": "object"}, "association": {"type": "object"}, "guards": {"type": "array"}, "control_kind": {"type": "string"}}},
    "span": {"type": "object", "additionalProperties": false, "required": ["start_offset", "end_offset_exclusive", "start_line", "start_column", "end_line", "end_column"], "properties": {"start_offset": {"type": "integer", "minimum": 0}, "end_offset_exclusive": {"type": "integer", "minimum": 0}, "start_line": {"type": "integer", "minimum": 1}, "start_column": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1}, "end_column": {"type": "integer", "minimum": 1}}}
  }
}
